        "kpis": [],
        "sql": "SELECT\n  c.cod_cliente,\n  td.cod_tipo_documento AS cod_tipo_documento,\n  c.num_identificacion,\n  CONCAT(TRIM(c.nombres), ' ', TRIM(c.apellidos)) AS nombre_completo,\n  TO_DATE(c.fecha_nacimiento, 'dd/MM/yyyy') AS fecha_nacimiento,\n  UPPER(TRIM(c.genero)) AS genero,\n  UPPER(TRIM(c.estado_civil)) AS estado_civil,\n  LOWER(TRIM(c.email)) AS email,\n  c.telefono_movil,\n  c.cod_provincia,\n  p.nombre_provincia,\n  p.region,\n  c.ciudad,\n  c.direccion,\n  UPPER(TRIM(c.segmento)) AS segmento,\n  TO_DATE(c.fecha_vinculacion, 'dd/MM/yyyy') AS fecha_vinculacion,\n  c.version_carga,\n  c.fecha_carga,\n  SHA2(CONCAT_WS('|', c.cod_cliente, c.num_identificacion, c.fecha_nacimiento, c.cod_provincia, c.segmento), 256) AS hash_atributos,\n  CURRENT_TIMESTAMP() AS __START_AT,\n  NULL AS __END_AT\nFROM workspace.bronce.clientes_pn_snapshot c\nLEFT JOIN workspace.referencia.tipos_documento td\n  ON ARRAY_CONTAINS(td.valores_origen, UPPER(TRIM(c.tipo_identificacion)))\nLEFT JOIN workspace.referencia.provincias p\n  ON p.cod_provincia = c.cod_provincia"
