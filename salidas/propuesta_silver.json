        "kpis": [],
        "sql": "SELECT\n  cp.num_cuenta,\n  cp.cod_cliente,\n  cp.cod_producto,\n  pr.nombre_producto,\n  pr.tipo_balance,\n  UPPER(TRIM(cp.estado)) AS estado,\n  CAST(REPLACE(cp.saldo, ',', '.') AS DECIMAL(18,2)) AS saldo,\n  TO_DATE(cp.fecha_apertura, 'dd/MM/yyyy') AS fecha_apertura,\n  cp.version_carga,\n  cp.fecha_carga\nFROM workspace.bronce.cuentas_pn_snapshot cp\nLEFT JOIN workspace.referencia.productos pr\n  ON pr.cod_producto = cp.cod_producto\nWHERE cp.version_carga = (\n  SELECT MAX(version_carga) FROM workspace.bronce.cuentas_pn_snapshot\n)"
