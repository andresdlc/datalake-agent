        "kpis": [],
        "sql": "SELECT\n  c.cod_cliente,\n  c.segmento,\n  c.nombre_provincia,\n  COUNT(p.num_cuenta) AS cant_cuentas,\n  SUM(p.saldo) AS saldo_total,\n  AVG(p.saldo) AS saldo_promedio,\n  c.fecha_vinculacion\nFROM workspace.clientes_pn_silver.clientes_pn_historico AS c\nLEFT JOIN workspace.clientes_pn_silver.cuentas_pn AS p\n  ON c.cod_cliente = p.cod_cliente\nWHERE c.__END_AT IS NULL  -- cliente vigente\n  AND p.estado = 'ACTIVO'  -- solo cuentas activas\nGROUP BY c.cod_cliente, c.segmento, c.nombre_provincia, c.fecha_vinculacion"
