        "sql": "SELECT\n  c.segmento,\n  c.nombre_provincia,\n  COUNT(DISTINCT c.cod_cliente) AS num_clientes,\n  SUM(c.saldo_total) AS saldo_total,\n  AVG(c.saldo_total) AS saldo_promedio\nFROM workspace.clientes_pn_gold.cliente_360 AS c\nGROUP BY c.segmento, c.nombre_provincia"
