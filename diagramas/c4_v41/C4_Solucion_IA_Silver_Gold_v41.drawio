        <mxCell id="d-grp" parent="1" vertex="1" value="&lt;b&gt;Grupos del dominio&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Identidad]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;grp_dl_&amp;lt;dominio&amp;gt;_{own,dev,lec}, emitidos desde Entra ID.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#102A43;fillColor=#D9D9D9;strokeColor=#8A8A8A;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="580" y="740" width="490" height="140"/>
        </mxCell>
        <mxCell id="r-cat" parent="1" vertex="1" value="&lt;b&gt;Catálogos prd_*&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor: Unity Catalog]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;prd_landing, prd_bronze, prd_silver, prd_gold, prd_control. Solo se vinculan a este workspace.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1190" y="400" width="470" height="140"/>
        </mxCell>
        <mxCell id="r-job" parent="1" vertex="1" value="&lt;b&gt;Job y pipelines del dominio (prd)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Primera carga en ventana planificada. Siguientes: incrementales. Bronze con pipelines.reset.allowed = false.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
