        <mxCell id="x-gha" parent="1" vertex="1" value="&lt;b&gt;GitHub Actions + DABs&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Federación OIDC hacia Databricks. Targets dev, qa y prd. bundle deploy publica pipelines y jobs; no carga datos.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
