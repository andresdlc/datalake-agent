        </mxCell>
        <mxCell id="d-devcat" parent="1" vertex="1" value="&lt;b&gt;Catálogos dev_*&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor: Unity Catalog]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;dev_landing, dev_bronze, dev_silver, dev_gold, dev_control. Primera ejecución manual, a cargo de quien desarrolla.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="70" y="400" width="480" height="140"/>
        </mxCell>
        <mxCell id="d-qacat" parent="1" vertex="1" value="&lt;b&gt;Catálogos qa_*&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor: Unity Catalog]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;qa_* en este mismo workspace. Tras fusionar a main, el CI despliega y ejecuta pipelines con datos de prueba.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="580" y="400" width="490" height="140"/>
        </mxCell>
        <mxCell id="d-ag" parent="1" vertex="1" value="&lt;b&gt;Agente, Apps opcional y MLflow 3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedores de desarrollo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;El agente corre aquí, con un SP de menor privilegio. No escribe en QA ni en prd con un usuario interactivo.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="70" y="570" width="480" height="140"/>
        </mxCell>
        <mxCell id="d-jobdev" parent="1" vertex="1" value="&lt;b&gt;Job y pipelines del dominio (dev / qa)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;pl_dom_&amp;lt;dominio&amp;gt;, slv y gld, parametrizados por ambiente. En dev la primera carga es manual; en qa, automática tras la fusión.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="580" y="570" width="490" height="140"/>
