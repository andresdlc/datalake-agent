        </mxCell>
        <mxCell id="a-mcp" parent="1" vertex="1" value="&lt;b&gt;Cliente MCP&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Comprobación de salud por servidor antes de usarlo. Configuración por ambiente.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="530" y="580" width="470" height="100"/>
        </mxCell>
        <mxCell id="a-ctx" parent="1" vertex="1" value="&lt;b&gt;Ensamblador del paquete de contexto&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Junta metadatos, estadísticas, estándar, etiquetas y observaciones. Sin filas ni PII en claro.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="530" y="710" width="470" height="120"/>
        </mxCell>
        <mxCell id="a-eval" parent="1" vertex="1" value="&lt;b&gt;Evaluador MLflow 3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;evaluate() contra un set propio del dominio (origen de capas, contrato, KPI, vigencia SCD2). Guarda trazas y tokens.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="530" y="860" width="470" height="120"/>
        </mxCell>
        <mxCell id="a-slv" parent="1" vertex="1" value="&lt;b&gt;Generador de propuesta Silver&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;hk_, lecturas solo desde Bronze o Silver transversal, SCD1 por defecto, AUTO CDC o FROM SNAPSHOT, expectations. Señala Data Vault; no lo aplica solo.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1110" y="300" width="560" height="140"/>
        </mxCell>
        <mxCell id="a-gld" parent="1" vertex="1" value="&lt;b&gt;Generador de propuesta Gold&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Estrella dim_ / fct_ y, si corresponde, agg_ o dp_. Grano, dueño y mapeo desde Silver. Gold no lee Bronze.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1110" y="460" width="560" height="120"/>
        </mxCell>
        <mxCell id="a-json" parent="1" vertex="1" value="&lt;b&gt;Emisor y validador del contrato JSON&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Identificador, versión, modo, entidades, lecturas, tipo_scd, patron_carga y expectations. El CI lo valida sin volver a llamar al modelo.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1110" y="600" width="560" height="120"/>
        </mxCell>
        <mxCell id="a-art" parent="1" vertex="1" value="&lt;b&gt;Generador de artefactos&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;DDL, Lakeflow, calidad/reglas.yml, documentación y etiquetas, bajo dominios/&amp;lt;dominio&amp;gt;/.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1110" y="740" width="560" height="120"/>
