          <mxGeometry as="geometry" x="350" y="70" width="250" height="140"/>
        </mxCell>
        <mxCell id="x-brz" parent="1" vertex="1" value="&lt;b&gt;Tablas Bronze&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor existente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;&amp;lt;amb&amp;gt;_bronze. Ya pobladas. La IA no escribe aquí. 7 snapshots en cargas diarias.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="40" y="260" width="280" height="130"/>
        </mxCell>
        <mxCell id="x-trx" parent="1" vertex="1" value="&lt;b&gt;Silver del dominio transversal&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Única dependencia cruzada permitida. Si está atrasado, se usa la última versión válida y se alerta la frescura.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="40" y="410" width="280" height="130"/>
        </mxCell>
        <mxCell id="x-trig" parent="1" vertex="1" value="&lt;b&gt;Disparadores del job&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente de orquestación]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Actualización de tablas Bronze o de transversal, y un horario diario de respaldo.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#102A43;fillColor=#D9D9D9;strokeColor=#8A8A8A;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="40" y="560" width="280" height="120"/>
        </mxCell>
        <mxCell id="t-slv" parent="1" vertex="1" value="&lt;b&gt;Tarea slv&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente: pipeline Lakeflow]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;pl_dom_&amp;lt;dominio&amp;gt;_slv. Streaming tables con AUTO CDC o AUTO CDC FROM SNAPSHOT según patron_carga. SCD1 por defecto; SCD2 solo si está justificado y registrado. Expectations WARN, DROP o FAIL. Sin MERGE manual. Lee solo Bronze o Silver transversal.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="400" y="300" width="420" height="210"/>
        </mxCell>
        <mxCell id="t-qc" parent="1" vertex="1" value="&lt;b&gt;Tarea control_calidad&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente: notebook de plataforma]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Porcentaje en cuarentena por tabla. Si supera el 2 % (configurable), falla, Gold no se refresca y se alerta al dueño. Notebook genérico, parametrizado por dominio.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="860" y="300" width="420" height="210"/>
        </mxCell>
        <mxCell id="t-gld" parent="1" vertex="1" value="&lt;b&gt;Tarea gld&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente: pipeline Lakeflow]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;pl_dom_&amp;lt;dominio&amp;gt;_gld. Materialized views dim_, fct_ y, si corresponde, agg_ o dp_. Solo corre si pasa la calidad. Lecturas únicamente desde Silver.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1320" y="300" width="450" height="210"/>
        </mxCell>
        <mxCell id="t-meta" parent="1" vertex="1" value="&lt;b&gt;Tarea aplicar_metadatos&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente: notebook de plataforma]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Comentarios, etiquetas gobernadas, máscaras o filtros ABAC y permisos de grp_dl_&amp;lt;dominio&amp;gt;_{own,dev,lec} y sp_dl_&amp;lt;amb&amp;gt;. Idempotente, cuando los objetos ya existen.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="860" y="600" width="420" height="200"/>
        </mxCell>
        <mxCell id="t-reg" parent="1" vertex="1" value="&lt;b&gt;Tarea registrar_ejecucion&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente: notebook de plataforma]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Siempre corre (ALL_DONE), con o sin refresco de Gold. Escribe &amp;lt;amb&amp;gt;_control.framework.ejecucion, la conciliación y el estado en el framework SQL.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1320" y="600" width="450" height="200"/>
        </mxCell>
        <mxCell id="d-slv" parent="1" vertex="1" value="&lt;b&gt;Catálogo Silver&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor de datos]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;&amp;lt;amb&amp;gt;_silver. Objetos creados en la primera ejecución y refrescados después.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="400" y="980" width="360" height="110"/>
        </mxCell>
        <mxCell id="d-gld" parent="1" vertex="1" value="&lt;b&gt;Catálogo Gold&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor de datos]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;&amp;lt;amb&amp;gt;_gold. No se publica si falla la calidad o la conciliación.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="800" y="980" width="360" height="110"/>
        </mxCell>
        <mxCell id="d-ctl" parent="1" vertex="1" value="&lt;b&gt;Catálogo de control&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor de datos]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;&amp;lt;amb&amp;gt;_control: calidad.regla, framework.ejecucion y conciliación.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
