        <mxCell id="r-sp" parent="1" vertex="1" value="&lt;b&gt;sp_dl_prd&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Identidad]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Ejecuta el job y es dueño de los objetos. Nunca un usuario interactivo y nunca el agente.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#102A43;fillColor=#D9D9D9;strokeColor=#8A8A8A;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1190" y="570" width="470" height="140"/>
        </mxCell>
        <mxCell id="r-sec" parent="1" vertex="1" value="&lt;b&gt;Gobierno en producción&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;ABAC, máscaras, etiquetas gobernadas, linaje, event log y registro de ejecución. Nadie escribe con su usuario.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#2E6295;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1690" y="570" width="480" height="140"/>
        </mxCell>
        <mxCell id="r-noag" parent="1" vertex="1" value="&lt;b&gt;Sin agente publicador&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Fuera de prd]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;El agente no despliega, no se autentica para lanzar jobs y no escribe en estos catálogos.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#102A43;fillColor=#D9D9D9;strokeColor=#8A8A8A;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="1190" y="740" width="980" height="140"/>
        </mxCell>
        <mxCell id="x-entra" parent="1" vertex="1" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Un solo tenant. Identidad corporativa, grupos y federación.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="40" y="1000" width="400" height="110"/>
        </mxCell>
        <mxCell id="x-kv" parent="1" vertex="1" value="&lt;b&gt;Azure Key Vault&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Scopes kv-dl-dev, kv-dl-qa y kv-dl-prd. Los secretos no viven en el código.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="470" y="1000" width="420" height="110"/>
        </mxCell>
        <mxCell id="x-ncc" parent="1" vertex="1" value="&lt;b&gt;Conectividad privada&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Network Connectivity Configurations u otro enlace privado, cuando aplique.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="920" y="1000" width="400" height="110"/>
        </mxCell>
        <mxCell id="x-mon" parent="1" vertex="1" value="&lt;b&gt;Azure Monitor / Log Analytics&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Auditoría de despliegues, event logs de Lakeflow y bitácoras de control.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
