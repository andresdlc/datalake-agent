        <mxCell id="d-spdev" parent="1" vertex="1" value="&lt;b&gt;sp_dl_dev y sp_dl_qa&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Identidad]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Dueños de los objetos de cada target. Secretos en kv-dl-dev y kv-dl-qa.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#102A43;fillColor=#D9D9D9;strokeColor=#8A8A8A;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
