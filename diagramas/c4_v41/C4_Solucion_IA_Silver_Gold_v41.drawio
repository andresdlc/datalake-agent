        <mxCell id="x-gw" parent="1" vertex="1" value="&lt;b&gt;Unity Gateway y Model Serving&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Contenedor]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Invocación gobernada del foundation model hospedado por Databricks.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#6B6B6B;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
