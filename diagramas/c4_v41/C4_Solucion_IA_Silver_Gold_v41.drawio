        <mxCell id="n3-agente-title" parent="1" vertex="1" value="C4 — Nivel 3: Componentes del agente de modelado&lt;br/&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;Ciclo de desarrollo. El agente propone; un humano aprueba; solo la versión APROBADA abre la PR.  ·  v4.1  ·  12-nov-2026&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;spacing=0;">
          <mxGeometry as="geometry" x="20" y="12" width="2200" height="56"/>
        </mxCell>
        <mxCell id="n3-agente-footer" parent="1" vertex="1" value="Versión 4.1  ·  12-nov-2026  ·  America/Guayaquil  ·  Arquitectura objetivo en Azure Databricks  ·  El banco no se nombra" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#555555;">
