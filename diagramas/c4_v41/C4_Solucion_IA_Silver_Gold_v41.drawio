        </mxCell>
        <mxCell id="a-orq" parent="1" vertex="1" value="&lt;b&gt;Orquestador del ciclo&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Modos crear y actualizar. Estados BORRADOR, EN_REVISION, REQUIERE_CAMBIOS y APROBADA. No despliega ni lanza jobs.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
          <mxGeometry as="geometry" x="530" y="300" width="470" height="110"/>
        </mxCell>
        <mxCell id="a-sql" parent="1" vertex="1" value="&lt;b&gt;Cliente SQL parametrizado&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;[Componente]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:9px'&gt;Service principal de menor privilegio (sp_dl_&amp;lt;amb&amp;gt; o principal del agente en dev). Sin token interactivo ni identificadores fijos.&lt;/font&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#0A2F4A;fillColor=#85BBF0;strokeColor=#5D8EBA;rounded=1;arcSize=8;metaEdit=0;spacing=4;spacingTop=4;">
